# Database Configuration
DATABASE_URL=mysql+pymysql://root:password@localhost/agricarbon
DB_AUTO_UPDATE=true
ENVIRONMENT=development

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-in-production-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Configuration
GEMINI_API_KEY=your-gemini-api-key

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Environment Settings
# development: Auto-update database schema (drops and recreates tables)
# production: Only create new tables, no schema updates
ENVIRONMENT=development

# Database Auto-Update
# true: Enable automatic database schema updates
# false: Only create new tables, no updates to existing ones
DB_AUTO_UPDATE=true